    {
      "id": "nmt23-q14",
      "type": "single_choice",
      "statement": "Обчисліть значення виразу\n$$\\frac{\\left(2^{10}-2^{9}\\right)\\cdot 3^{4}}{2^{8}\\cdot 3^{3}+2^{8}\\cdot 3^{3}}$$",
      "options": [
        {
          "id": "nmt23-q14-o1",
          "content": "$1$"
        },
        {
          "id": "nmt23-q14-o2",
          "content": "$\\dfrac{3}{2}$"
